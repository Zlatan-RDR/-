    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Miqbas.Unity.AndroidCore</AssemblyName>
    <RootNamespace>Miqbas.Unity.AndroidCore</RootNamespace>
