  <ItemGroup>
    <Reference Include="AssetsTools.NET">
      <HintPath Condition="Exists('..\libs\AssetsTools.NET.dll')">..\libs\AssetsTools.NET.dll</HintPath>
      <HintPath Condition="!Exists('..\libs\AssetsTools.NET.dll')">../../Miqbas-Extracted/lib/app/AssetsTools.NET.dll</HintPath>
    </Reference>
    <Reference Include="AssetsTools.NET.MonoCecil">
      <HintPath Condition="Exists('..\libs\AssetsTools.NET.MonoCecil.dll')">..\libs\AssetsTools.NET.MonoCecil.dll</HintPath>
      <HintPath Condition="!Exists('..\libs\AssetsTools.NET.MonoCecil.dll')">../../Miqbas-Extracted/lib/app/AssetsTools.NET.MonoCecil.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\classdata.tpk" />
    <EmbeddedResource Include="Resources\IBMPlexSansArabic-Regular.atlas.bin" />
    <EmbeddedResource Include="Resources\IBMPlexSansArabic-Regular.atlas.json" />
    <EmbeddedResource Include="Resources\NotoSansArabicCondensedMiqbas-Medium.atlas.bin" />
